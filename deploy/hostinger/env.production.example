# ==============================================================================
# Vortexen Estimator — Hostinger KVM 2 Co-Hosting Environment (/opt/vortexen-estimator/.env)
# Co-hosts cleanly alongside Market Intel DB on 189.72.180.37 without conflicts.
# Permissions on VPS MUST be: root:root 0640 (or 0600) — NEVER commit real secrets.
# ==============================================================================

# Single domain serving both Next.js (/) and Django API (/api/, /admin/)
VORTEXEN_DOMAIN=estimator.vortexen.com

# Deployment image tag (managed automatically by /usr/local/sbin/vortexen-deploy)
IMAGE_TAG=latest

# Django Core Security
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate with: openssl rand -hex 48
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_48

# Strict Host / CORS / CSRF allowlists (NO wildcards in production)
ALLOWED_HOSTS=estimator.vortexen.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://estimator.vortexen.com
CSRF_TRUSTED_ORIGINS=https://estimator.vortexen.com

# Database (isolated container vortexen-db; NO host port 5432 exposure)
POSTGRES_DB=vortexen_estimator
POSTGRES_USER=vortexen
# Generate with: openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://vortexen:CHANGE_ME_STRONG_DB_PASSWORD@vortexen-db:5432/vortexen_estimator
ENABLE_POSTGIS=false

# Redis & Celery (isolated container vortexen-redis)
CELERY_BROKER_URL=redis://vortexen-redis:6379/0
CELERY_RESULT_BACKEND=redis://vortexen-redis:6379/1

# Extraction Engine & Upload Guardrails (tuned for KVM 2: 2 vCPU / 8 GB RAM)
EXTRACTION_EXECUTION_MODE=celery
EXTRACTION_WORK_DIR=/data/uploads
MAX_UPLOAD_ZIP_BYTES=1073741824
MAX_UPLOAD_DXF_BYTES=536870912
MAX_UPLOAD_IFC_BYTES=1073741824
EXTRACTION_MAX_ARCHIVE_ENTRIES=10000
EXTRACTION_MAX_UNCOMPRESSED_BYTES=5368709120
EXTRACTION_MAX_COMPRESSION_RATIO=100.0
IFC_GEOMETRY_THREADS=1
IFC_GEOMETRY_TIMEOUT_SECONDS=120.0
CELERY_WORKER_MAX_TASKS_PER_CHILD=20

# Optional AI Assistant Provider (extraction remains 100% deterministic)
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=deterministic-v1

# Optional GPG passphrase for encrypted daily backups
BACKUP_ENCRYPTION_PASSPHRASE=
