# ==============================================================================
# Vortexen Estimator — Environment Configuration Template
# Copy to .env for local development. Never commit real secrets.
# ==============================================================================

# Optional pre-mounted source directory on server (for batch/CLI imports; API uploads stream to EXTRACTION_WORK_DIR/uploads)
ALLOWED_SOURCE_ROOTS=./extracted_tmp

# Extraction & Security Limits
EXTRACTION_WORK_DIR=./extracted_tmp
MAX_UPLOAD_ZIP_BYTES=1073741824
EXTRACTION_MAX_ARCHIVE_ENTRIES=10000
EXTRACTION_MAX_UNCOMPRESSED_BYTES=5368709120
EXTRACTION_MAX_COMPRESSION_RATIO=100
EXTRACTION_MAX_XML_DEPTH=64
EXTRACTION_MAX_XML_NODES=2000000
EXTRACTION_MAX_PARSE_SECONDS=300
EXTRACTION_EXECUTION_MODE=eager

# Django Backend
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-cryptographically-random-secret-key-min-50-chars
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL + optional PostGIS in staging/prod, SQLite fallback in dev/test)
DATABASE_URL=sqlite:///backend/db.sqlite3
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://vortexen:change_me@localhost:5432/vortexen_estimator
ENABLE_POSTGIS=false

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Estimation Providers (independent from native extraction)
# Supported: deterministic (offline SQL/Graph/RAG grounded), openai, anthropic, gemini
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=deterministic-v1
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Next.js Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
